# Copy this file to .env (for local dev) — never commit the real .env file.
# In production, set this as an Environment Variable in your Vercel project settings instead.

ANTHROPIC_API_KEY=sk-ant-...

# These are added automatically when you connect a Vercel KV database to the
# project (Storage tab -> Create Database -> KV -> Connect Project).
# You do not need to set them by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
